# Environment for the docker-compose path. Copy to ./.env (next to
# docker-compose.yml) and fill in your broker. Compose auto-loads a .env file
# from the same directory. These are the ONLY settings the bridge takes from the
# environment; everything else lives in options.json.

# Image architecture tag. The image is published per-arch as
# ghcr.io/jaxzin/ha-seestar-<arch>. Default is amd64. On a 64-bit ARM host
# (e.g. a dedicated Raspberry Pi) set ARCH=aarch64, or you will pull the amd64
# image and it will not run.
ARCH=amd64

# MQTT broker (REQUIRED — no Supervisor/Mosquitto add-on to resolve it here).
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Set MQTT_SSL=true and MQTT_PORT=8883 to connect over TLS; the system CA is used.
MQTT_SSL=false
