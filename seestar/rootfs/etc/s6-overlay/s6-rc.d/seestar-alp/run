#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# seestar-alp longrun — the bundled Alpaca driver (bundled mode) OR the ingress
# info page (external mode).
#
# Conditional: the real seestar_alp runs ONLY in bundled mode (alpaca_host
# blank). In external mode the operator reuses their own seestar_alp, so nothing
# here serves the ingress port (config.yaml ingress_port: 5432) — which used to
# 502 the "Open Web UI" panel. Instead this slot runs a tiny foreground info
# server that links out to the external web UI, keeping the process alive so s6
# does not restart-loop it. init-config has already validated that exactly one of
# scopes/alpaca_host is set and (in bundled mode) written config.toml, and (in
# external mode) exported SEESTAR_EXTERNAL_WEBUI_URL for the info server.
# ==============================================================================

if bashio::config.has_value 'alpaca_host'; then
    bashio::log.info \
        "External Alpaca driver configured; serving the ingress info page."
    exec /etc/s6-overlay/scripts/ingress-info-server
fi

bashio::log.info "Starting bundled seestar_alp driver."
cd /app/seestar_alp || bashio::exit.nok "seestar_alp directory missing from image."
exec python3 root_app.py
